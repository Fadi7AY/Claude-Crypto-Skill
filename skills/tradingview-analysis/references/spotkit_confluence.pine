//@version=6
// Spotkit Confluence - mirrors the score used by the spot bot (skills/_spotkit/spotkit/signals.py)
// so the chart shows the same entries the bot takes. Long-only. Alerts send JSON for tv_webhook.py.
strategy("Spotkit Confluence (spot, long-only)", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=20,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2,
     process_orders_on_close=false, calc_on_every_tick=false)

entryScore = input.int(40, "Entry score", minval=0, maxval=100)
exitScore  = input.int(-20, "Exit score", minval=-100, maxval=0)
stopAtr    = input.float(2.0, "Stop (ATR multiples)", step=0.25)
tpR        = input.float(2.0, "Take profit (R multiples, 0 = off)", step=0.25)
htf        = input.timeframe("240", "Higher timeframe trend filter")
useHtf     = input.bool(true, "Require higher-timeframe uptrend")
secret     = input.string("CHANGE_ME", "Webhook secret (must equal TV_WEBHOOK_SECRET)")

ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi = ta.rsi(close, 14)
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)
atr = ta.atr(14)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
[stLine, stDir] = ta.supertrend(3.0, 10)   // stDir < 0 means uptrend in Pine
dcUpper = ta.highest(high, 20)[1]
dcLower = ta.lowest(low, 20)[1]
volZ = (volume - ta.sma(volume, 20)) / ta.stdev(volume, 20)

sgn(x) => na(x) ? 0.0 : x > 0 ? 1.0 : x < 0 ? -1.0 : 0.0

strength = adx < 15 ? 0.6 : adx < 25 ? 0.8 : 1.0
trend = (0.40 * sgn(close - ema200) + 0.35 * sgn(ema50 - ema200) + 0.25 * sgn(ema20 - ema50)) * strength
momentum = 0.5 * sgn(hist) + 0.2 * sgn(hist - hist[1]) + 0.3 * math.max(-1, math.min(1, (rsi - 50) / 25)) - (rsi > 78 ? 0.3 : 0.0)
breakout = close > dcUpper ? 1.0 : close < dcLower ? -1.0 : 0.0
structure = (0.6 * (stDir < 0 ? 1.0 : -1.0) + 0.4 * breakout) * strength
volScore = volZ > 1 ? sgn(close - open) * math.min(volZ / 3, 1) : 0.0
score = 100 * (0.35 * math.max(-1, math.min(1, trend)) + 0.30 * math.max(-1, math.min(1, momentum)) + 0.25 * math.max(-1, math.min(1, structure)) + 0.10 * volScore)

htfUp = request.security(syminfo.tickerid, htf, close > ta.ema(close, 200) and ta.ema(close, 50) > ta.ema(close, 200), lookahead=barmerge.lookahead_off)

longCond = barstate.isconfirmed and score >= entryScore and (not useHtf or htfUp) and strategy.position_size == 0
exitCond = barstate.isconfirmed and score <= exitScore and strategy.position_size > 0

var float stopPx = na
var float tpPx = na
if longCond
    stopPx := close - stopAtr * atr
    tpPx := tpR > 0 ? close + tpR * (close - stopPx) : na
    strategy.entry("Long", strategy.long)
    alert('{"secret":"' + secret + '","action":"buy","symbol":"' + syminfo.ticker + '","stop":' + str.tostring(stopPx) + (na(tpPx) ? '' : ',"target":' + str.tostring(tpPx)) + ',"reason":"TV confluence ' + str.tostring(score, "#") + '"}', alert.freq_once_per_bar_close)
if strategy.position_size > 0
    strategy.exit("Exit", "Long", stop=stopPx, limit=tpPx)
if exitCond
    strategy.close("Long")
    alert('{"secret":"' + secret + '","action":"sell","symbol":"' + syminfo.ticker + '"}', alert.freq_once_per_bar_close)

plot(ema50, "EMA 50", color=color.new(color.orange, 30))
plot(ema200, "EMA 200", color=color.new(color.blue, 30))
plot(strategy.position_size > 0 ? stopPx : na, "Stop", color=color.red, style=plot.style_linebr)
plot(strategy.position_size > 0 ? tpPx : na, "Target", color=color.green, style=plot.style_linebr)
plotshape(longCond, "Entry", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(exitCond, "Signal exit", shape.triangledown, location.abovebar, color.red, size=size.small)
var table t = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(t, 0, 0, "Score " + str.tostring(score, "#"), text_color=color.white, bgcolor=score >= entryScore ? color.green : score <= exitScore ? color.red : color.gray)
